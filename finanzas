            if (deudas.length === 0) {
                html += '<div class="empty-state"><div class="icon">👥</div><p>No hay deudas</p></div>';
            } else {
                for (const d of deudas) {
                    html += `
                    <div class="deuda-item ${d.estado === 'Pago' || d.estado === 'pago' ? 'pagado' : 'debe'}">
                        <div class="deuda-info">
                            <div class="deuda-nombre">${d.persona}</div>
                            <div class="deuda-monto">${fmt(d.monto)}</div>
                        </div>
                        <div style="display:flex;align-items:center;gap:6px;">
                            <span class="badge ${d.estado==='Pago'||d.estado==='pago'?'badge-success':'badge-danger'}">${d.estado}</span>
                            <button class="btn btn-sm btn-outline" onclick="toggleDeudaGeneral(${d.id})">🔄</button>
                            <button class="btn btn-sm btn-danger" onclick="eliminarItem(${d.id},'deudas')">🗑</button>
                        </div>
                    </div>`;
                }
            }
            html += '</div>';
            container.innerHTML = html;
        }

        function agregarDeudaModal(store) {
            currentModalType = 'deuda';
            editId = null;
            openModal(`
                <h3>Agregar Deuda</h3>
                <form onsubmit="guardarDeudaGeneral(event,'${store}')">
                    <div class="form-group"><label>Persona</label><input type="text" id="dg-persona" required></div>
                    <div class="form-group"><label>Monto</label><input type="number" id="dg-monto" required min="0" step="0.01"></div>
                    <div class="form-group"><label>Estado</label><select id="dg-estado"><option value="Debe">Debe</option><option value="Pago">Pago</option></select></div>
                    <button type="submit" class="btn btn-primary" style="width:100%;">Guardar</button>
                    <button type="button" class="btn btn-outline" style="width:100%;margin-top:8px;" onclick="closeModal()">Cancelar</button>
                </form>`);
        }

        async function guardarDeudaGeneral(e, store) {
            e.preventDefault();
            const data = {
                persona: document.getElementById('dg-persona').value,
                monto: parseFloat(document.getElementById('dg-monto').value),
                estado: document.getElementById('dg-estado').value
            };
            if (editId) { data.id = editId; await dbPut(store, data); }
            else await dbAdd(store, data);
            closeModal();
            await renderAll();
        }

        async function toggleDeudaGeneral(id) {
            const deudas = await dbGetAll('deudas');
            const d = deudas.find(x => x.id === id);
            if (!d) return;
            d.estado = d.estado === 'Pago' ? 'Debe' : 'Pago';
            await dbPut('deudas', d);
            await renderDeudasGenerales();
        }

        // ==================== START ====================
        init();
    </script>
</body>
</html>
