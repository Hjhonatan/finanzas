        async function renderTarjeta() {
            const container = document.getElementById('tarjeta-container');
            const gastos = await dbGetAll('tarjeta_gastos');
            const deudas = await dbGetAll('tarjeta_deudas');

            // Agrupar por corte
            const cortes = {};
            for (const g of gastos) {
                const c = g.corte || 'Sin corte';
                if (!cortes[c]) cortes[c] = { gastos: [], deudas: [] };
                cortes[c].gastos.push(g);
            }
            for (const d of deudas) {
                const c = d.corte || 'Sin corte';
                if (!cortes[c]) cortes[c] = { gastos: [], deudas: [] };
                cortes[c].deudas.push(d);
            }

            let html = '';
            const nombresCortes = Object.keys(cortes).sort().reverse();

            if (nombresCortes.length === 0) {
                html = '<div class="empty-state"><div class="icon">💳</div><p>No hay cortes de tarjeta</p></div>';
            }

            for (const corte of nombresCortes) {
                const data = cortes[corte];
                const totalGastado = data.gastos.filter(g => g.tipo === 'Gasto').reduce((s,g) => s + g.monto, 0);
                const totalAhorrado = data.gastos.filter(g => g.tipo === 'Ahorro').reduce((s,g) => s + g.monto, 0);
                const deudasDebe = data.deudas.filter(d => d.estado === 'Debe').reduce((s,d) => s + d.monto, 0);
                const deudasPago = data.deudas.filter(d => d.estado === 'Pago').reduce((s,d) => s + d.monto, 0);
                const totalDeudasAFavor = deudasDebe; // Solo las que "Debe" están a tu favor
                const saldoFinal = totalAhorrado + totalDeudasAFavor;
                const haceFalta = totalGastado - totalAhorrado - totalDeudasAFavor;

                html += `
                <div class="card">
                    <div class="card-header">
                        <span class="card-title">💳 Corte: ${corte}</span>
                        <span class="badge badge-warning">📅 Límite: 9 de cada mes</span>
                        <div class="btn-group">
                            <button class="btn btn-outline btn-sm" onclick="duplicarCorteTarjeta('${corte}')">📋 Duplicar</button>
                            <button class="btn btn-outline btn-sm" onclick="agregarGastoTarjetaModal('${corte}')">➕ Gasto</button>
                            <button class="btn btn-outline btn-sm" onclick="agregarDeudaTarjetaModal('${corte}')">➕ Deuda</button>
                            <button class="btn btn-danger btn-sm" onclick="eliminarCorteTarjeta('${corte}')">🗑 Corte</button>
                        </div>
                    </div>

                    <!-- Gastos del corte -->
                    <h4 style="margin-bottom:8px;">📊 Movimientos</h4>
                    <div class="table-container">
                        <table>
                            <thead><tr><th>Tipo</th><th>Concepto</th><th>Monto</th><th></th></tr></thead>
                            <tbody>
                                ${data.gastos.map(g => `
                                    <tr class="${g.tipo==='Ahorro'?'row-ingreso':'row-gasto'}">
                                        <td>${g.tipo}</td><td>${g.concepto||g.categoria||''}</td>
                                        <td>${fmt(g.monto)}</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline" onclick="editarGastoModal(${g.id},'tarjeta_gastos')">✏️</button>
                                            <button class="btn btn-sm btn-danger" onclick="eliminarItem(${g.id},'tarjeta_gastos')">🗑</button>
                                        </td>
                                    </tr>`).join('')}
                            </tbody>
                        </table>
                    </div>

                    <!-- Deudas del corte -->
                    <h4 style="margin:12px 0 8px;">👥 Deudas a tu favor</h4>
                    ${data.deudas.map(d => `
                        <div class="deuda-item ${d.estado === 'Pago' ? 'pagado' : 'debe'}">
                            <div class="deuda-info">
                                <div class="deuda-nombre">${d.persona}</div>
                                <div class="deuda-monto">${fmt(d.monto)}</div>
                            </div>
                            <div style="display:flex;align-items:center;gap:6px;">
                                <span class="badge ${d.estado==='Pago'?'badge-success':'badge-danger'}">${d.estado}</span>
                                <button class="btn btn-sm btn-outline" onclick="toggleDeudaTarjeta(${d.id})">🔄</button>
                                <button class="btn btn-sm btn-danger" onclick="eliminarItem(${d.id},'tarjeta_deudas')">🗑</button>
                            </div>
                        </div>
                    `).join('')}
                    ${data.deudas.length === 0 ? '<p style="color:var(--text-light);font-size:0.85em;">Sin deudas registradas</p>' : ''}

                    <!-- Resumen del corte -->
                    <hr>
                    <div class="summary-grid">
                        <div class="summary-item"><h4>Total Gastado</h4><div class="val negative">${fmt(totalGastado)}</div></div>
                        <div class="summary-item"><h4>Total Ahorrado</h4><div class="val positive">${fmt(totalAhorrado)}</div></div>
                        <div class="summary-item"><h4>Deudas a favor</h4><div class="val neutral">${fmt(totalDeudasAFavor)}</div></div>
                        <div class="summary-item"><h4>Deudas Pagadas</h4><div class="val neutral">${fmt(deudasPago)}</div></div>
                        <div class="summary-item"><h4>Saldo Final</h4><div class="val positive">${fmt(saldoFinal)}</div></div>
                        <div class="summary-item"><h4>Hace Falta</h4><div class="val ${haceFalta <= 0 ? 'positive' : 'negative'}">${fmt(haceFalta)}</div></div>
                    </div>
                </div>`;
            }

            container.innerHTML = html;
        }

