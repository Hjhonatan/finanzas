            if (confirm(`¿Eliminar TODA la quincena ${quincena} de ${mes}?`)) {
                const items = await dbGetAll(store);
                for (const item of items) {
                    if (item.mes === mes && item.quincena === quincena) {
                        await dbDelete(store, item.id);
                    }
                }
                await renderAll();
            }
        }

