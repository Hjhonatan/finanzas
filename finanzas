        async function duplicarQuincena(mes, quincena, store) {
            const nuevoMes = prompt('Nombre del nuevo mes:');
            if (!nuevoMes) return;
            const items = await dbGetAll(store);
            const aDuplicar = items.filter(i => i.mes === mes && i.quincena === quincena);
            for (const item of aDuplicar) {
                const nuevo = { ...item };
                delete nuevo.id;
                nuevo.mes = nuevoMes;
                if (nuevo.corte !== undefined) nuevo.corte = nuevoMes + ' (copia)';
                await dbAdd(store, nuevo);
            }
            await renderAll();
            alert('Duplicado a ' + nuevoMes);
        }

